{
  "name": "Rust Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
  },
  "mounts": [
    "source=rstutils-zsh-history,target=/commandhistory,type=volume"
  ],
  "runArgs": [
    "--network=host"
  ],
  "forwardPorts": [],
  "customizations": {
    "vscode": {
      "settings": {
        "todo-tree.ripgrep.ripgrep": "/usr/bin/rg"
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "eamodio.gitlens",
        "Gruntfuggly.todo-tree"
      ]
    }
  },
  "postCreateCommand": "pre-commit install --install-hooks",
  "remoteUser": "vscode"
}
